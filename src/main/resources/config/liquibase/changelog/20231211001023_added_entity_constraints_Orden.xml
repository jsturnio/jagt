<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Orden.
    -->
    <changeSet id="20231211001023-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="paquete_id"
                                 baseTableName="orden"
                                 constraintName="fk_orden__paquete_id"
                                 referencedColumnNames="id"
                                 referencedTableName="paquete"
                                 />

        <addForeignKeyConstraint baseColumnNames="usuario_id"
                                 baseTableName="orden"
                                 constraintName="fk_orden__usuario_id"
                                 referencedColumnNames="id"
                                 referencedTableName="empleado"
                                 />

        <addForeignKeyConstraint baseColumnNames="bioquimico_id"
                                 baseTableName="orden"
                                 constraintName="fk_orden__bioquimico_id"
                                 referencedColumnNames="id"
                                 referencedTableName="bioquimico"
                                 />
    </changeSet>
</databaseChangeLog>
